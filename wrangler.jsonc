{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thwip",
  "main": "apps/control-plane/src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "env": {
    "staging": {
      "name": "thwip-staging",
      "routes": [{ "pattern": "thwip.recall.net", "custom_domain": true }],
      "assets": {
        "directory": "apps/control-plane/dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/v1/*", "/admin/*", "/health", "/.well-known/*"]
      },
      "durable_objects": {
        "bindings": [{ "name": "BRANCH_QUEUE", "class_name": "BranchQueue" }]
      },
      "migrations": [
        { "tag": "v1-branch-queue", "new_sqlite_classes": ["BranchQueue"] }
      ],
      "r2_buckets": [
        {
          "binding": "EVIDENCE",
          "bucket_name": "thwip-evidence-staging"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "thwip-staging-wnam",
          "database_id": "647114a5-9ad9-4895-b23e-92bbfaf8ab41",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "SYNC_QUEUE", "queue": "thwip-sync-staging" }],
        "consumers": [
          { "queue": "thwip-sync-staging", "dead_letter_queue": "thwip-sync-staging-dlq", "max_retries": 5 }
        ]
      },
      "triggers": { "crons": ["17 3 * * *", "*/5 * * * *"] },
      "vars": {
        "THWIP_ENV": "staging",
        "PUBLIC_ORIGIN": "https://thwip.recall.net",
        "BUILD_SHA": "dev",
        "STRIPE_PRICE_MONTHLY": "price_1TyISWLWdKonGktl1HFOwBIU",
        "STRIPE_PRICE_ANNUAL": "price_1TyISXLWdKonGktlMUXHk6DB",
        "GITHUB_APP_ID": "4419870",
        "GITHUB_APP_SLUG": "thwip-dev",
        "GITHUB_APP_CLIENT_ID": "Iv23lieihhxZU5ZzGg75"
      }
    }
  }
}
