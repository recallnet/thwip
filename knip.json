{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  "include": ["files", "dependencies", "unlisted", "binaries", "unresolved"],
  "exclude": ["exports", "types", "nsExports", "nsTypes", "enumMembers", "duplicates"],

  "ignoreDependencies": ["cloudflare", "@thwip/cli"],
  "ignoreBinaries": ["wrangler"],

  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/control-plane": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "src/**/*.workers.test.ts",
        "test/**/*.ts",
        "web/src/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "web/src/**/*.{ts,tsx}"]
    },
    "apps/blog": {
      "entry": [
        "astro.config.mjs",
        "markdoc.config.mjs",
        "src/content.config.ts",
        "src/pages/**/*.{ts,astro}",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,astro,css}", "*.mjs", "scripts/**/*.mjs"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
