{
  "$schema": "https://unpkg.com/knip@5/schema.json",

  "include": ["files", "dependencies", "unlisted", "binaries", "unresolved", "exports"],
  "exclude": ["types", "nsExports", "nsTypes", "enumMembers", "duplicates"],

  "ignoreDependencies": ["cloudflare"],
  "ignoreBinaries": ["thwip"],

  "workspaces": {
    ".": {
      "project": ["scripts/**/*.mjs"]
    },
    "apps/control-plane": {
      "entry": [
        "src/index.ts",
        "src/**/*.test.ts",
        "src/**/*.workers.test.ts",
        "test/**/*.ts",
        "web/src/**/*.test.ts"
      ],
      "project": ["src/**/*.ts", "web/src/**/*.{ts,tsx}"]
    },
    "apps/blog": {
      "entry": [
        "src/pages/**/*.{ts,astro}"
      ],
      "project": ["src/**/*.{ts,astro}", "*.mjs"]
    },
    "packages/migration-plan": {
      "project": ["src/**/*.{mjs,mts}"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
