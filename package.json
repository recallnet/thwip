{
  "name": "thwip-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs",
    "test:workers": "pnpm --filter @thwip/control-plane run test:workers"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
