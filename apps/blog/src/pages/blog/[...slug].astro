---
import { render } from "astro:content";
import Byline from "../../components/Byline.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { authorFor, personRefJsonLd } from "../../lib/authors";
import { publishedPosts, type BlogPost } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}
const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}/`;
const site = Astro.site ?? new URL("https://thwip.ai");
const pageUrl = new URL(path, site).href;
const publisher = { "@type": "Organization", name: "thwip", url: site.href };
const written = authorFor(post.data.author);
// An agent is not a Person, so a post it drafted is published under the
// organization's name, and the reviewer carries the accountability.
const author =
  written.kind === "person" ? personRefJsonLd(post.data.author, site) : publisher;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    author,
    ...(post.data.reviewedBy
      ? { reviewedBy: personRefJsonLd(post.data.reviewedBy, site) }
      : {}),
    mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
    publisher,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: new URL("/blog/", site).href,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: post.data.title,
        item: pageUrl,
      },
    ],
  },
];
---
<BlogLayout
  title={`${post.data.title} · thwip`}
  description={post.data.description}
  canonicalPath={path}
  ogImage={post.data.heroImage}
  jsonLd={jsonLd}
>
  <article class="eb-article">
    <header class="eb-article__header">
      <Byline
        author={post.data.author}
        reviewedBy={post.data.reviewedBy}
        pubDate={post.data.pubDate}
      />
      <h1>{post.data.title}</h1>
      <p class="eb-lede">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <div class="eb-tags">
            {post.data.tags.map((tag) => (
              <span class="eb-tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>
    {
      post.data.heroImage && (
        <figure class="eb-hero">
          <img
            src={post.data.heroImage}
            alt={post.data.heroAlt ?? ""}
            width="1200"
            height="630"
            decoding="async"
          />
        </figure>
      )
    }
    <div class="eb-prose">
      <Content />
    </div>
    <p class="eb-md-alt">
      Agents: raw Markdoc at <a href={`/blog/${post.id}.md`}>/blog/{post.id}.md</a>.
    </p>
  </article>
</BlogLayout>
