{
  "name": "@thwip/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/generate-prompt-docs.mjs && tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:staging": "pnpm -w -r build && node ../../scripts/predeploy.mjs --env staging && BUILD_SHA=\"$(node ../../scripts/build-sha.mjs)\" && DEPLOY_EXCEPTION=\"$(node ../../scripts/deploy-exception.mjs)\" && wrangler deploy --env staging --var BUILD_SHA:\"$BUILD_SHA\" --var DEPLOY_EXCEPTION:\"$DEPLOY_EXCEPTION\" && node ../../scripts/confirm-deploy.mjs --env staging --sha \"$BUILD_SHA\"",
    "migrate:staging": "node ../../scripts/migrate.mjs --env staging --database thwip-staging-wnam",
    "dev": "wrangler dev --env staging",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@andrewxhill/graphics-press-css": "^4.7.2",
    "@better-auth/stripe": "^1.6.25",
    "better-auth": "^1.6.25",
    "hono": "^4.12.34",
    "jose": "^6.0.0",
    "kysely": "^0.29.4",
    "kysely-d1": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.3.2",
    "@thwip/prompts": "workspace:*",
    "@thwip/policy": "workspace:*",
    "@thwip/queue-domain": "workspace:*",
    "@thwip/vocabulary": "workspace:*",
    "@thwip/queue-protocol": "workspace:*",
    "@thwip/protocol": "workspace:*",
    "@thwip/verifier": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250712.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "better-sqlite3": "^13.0.1",
    "vite": "^8.1.5",
    "wrangler": "^4.0.0"
  }
}
